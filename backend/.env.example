# Server
PORT=8000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (the Vite dev server, the deployed frontend).
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# Supabase project (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key: server-side only, bypasses Row-Level Security. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT Secret (Project Settings -> API -> JWT Settings): used to verify Supabase-issued access tokens locally, without a network round-trip.
SUPABASE_JWT_SECRET=your-jwt-secret

# Gemini (D5) - used from Phase 8 (AI tutor proxy) onward. Not required for Phase 1/2.
GEMINI_API_KEY=

# Piston execution service (Phase 2). Defaults to the docker-compose service name/port.
PISTON_API_URL=https://emkc.org/api/v2/piston
