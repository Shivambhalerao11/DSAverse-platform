# Backend API base (see backend/.env.example for the server side)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase project (Project Settings -> API in the Supabase dashboard).
# Not yet wired into src/services/auth/* — that's Phase 5 (frontend/backend
# integration) per docs/dsaverse-2-migration-plan.md. Documented here now so
# the same project's keys are ready when that phase lands.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI tutor (D5: Gemini). Still proxied through the backend once Phase 8 lands
# (see backend/.env.example GEMINI_API_KEY) - do not set a real key here,
# VITE_* vars ship in the client bundle.
VITE_AI_PROVIDER=mock
